[Unit]
Description=NEMOS defensive network sensor and SOC dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nemos
Group=nemos
WorkingDirectory=/opt/nemos
EnvironmentFile=-/etc/nemos/nemos.env
ExecStart=/opt/nemos/.venv/bin/python /opt/nemos/main.py
Restart=on-failure
RestartSec=3
# NEMOS pings this watchdog itself (nemos/watchdog.py) whenever packet
# capture is healthy, and stops pinging the moment it is not -- so a capture
# thread that dies without the process exiting still gets the process
# restarted, which Restart=on-failure alone cannot do. NotifyAccess=main is
# required for systemd to honour sd_notify() calls from a Type=simple unit.
NotifyAccess=main
WatchdogSec=90
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/nemos /opt/nemos/data
CapabilityBoundingSet=CAP_NET_RAW
AmbientCapabilities=CAP_NET_RAW
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_PACKET

[Install]
WantedBy=multi-user.target
