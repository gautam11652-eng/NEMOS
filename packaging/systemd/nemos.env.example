# Local-only is the safe default. Change only when remote access is required.
NEMOS_HOST=127.0.0.1
NEMOS_PORT=5000
NEMOS_CAPTURE=true
# NEMOS_INTERFACE=eth0
# NEMOS_API_TOKEN=replace-with-a-long-random-secret
# NEMOS_TRUSTED_HOSTS=127.0.0.1,localhost
NEMOS_DB=/var/lib/nemos/nemos.db
NEMOS_LOG_LEVEL=INFO

# Optional Telegram dashboard status / alert channel configuration
# TELEGRAM_BOT_TOKEN=replace-with-bot-token
# TELEGRAM_CHAT_ID=replace-with-chat-id
