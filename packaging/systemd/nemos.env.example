# Local-only is the safe default. Change only when remote access is required.
NEMOS_HOST=127.0.0.1
NEMOS_PORT=5000
NEMOS_CAPTURE=true
# NEMOS_INTERFACE=eth0
# NEMOS_API_TOKEN=replace-with-a-long-random-secret
# NEMOS_TRUSTED_HOSTS=127.0.0.1,localhost
NEMOS_DB=/var/lib/nemos/nemos.db
NEMOS_LOG_LEVEL=INFO

# Optional outbound alert delivery. Findings are always recorded locally; these
# settings only control whether a copy is pushed to a channel.
# TELEGRAM_BOT_TOKEN=replace-with-bot-token
# TELEGRAM_CHAT_ID=replace-with-chat-id
# NEMOS_WEBHOOK_URL=https://collector.example/hook
# NEMOS_WEBHOOK_TOKEN=replace-with-bearer-token

# Severity floor and flood control for outbound alerts.
# NEMOS_NOTIFY_MIN_SEVERITY=HIGH
# NEMOS_NOTIFY_COOLDOWN=300
# NEMOS_NOTIFY_RATE=12

# Dead-man's switch: alert if packet capture goes this long with no traffic.
# Off by default -- a quiet network and a cable pull look the same from
# packet volume alone, so only enable this if your link should never truly
# go idle. Capture-thread death is always detected, independent of this.
# NEMOS_HEARTBEAT_SECONDS=300
