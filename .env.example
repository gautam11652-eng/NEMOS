# Safe local default: dashboard is only reachable from this machine.
NEMOS_HOST=127.0.0.1
NEMOS_PORT=5000

# Optional capture interface. Leave empty to let Scapy choose.
NEMOS_INTERFACE=

NEMOS_CAPTURE=true
NEMOS_DB=data/nemos.db
NEMOS_DB_BATCH=250
NEMOS_DB_FLUSH_SECONDS=0.5

# Required if NEMOS_HOST is not loopback.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
NEMOS_API_TOKEN=
# Required for wildcard remote binds such as 0.0.0.0. Comma-separated Host values.
NEMOS_TRUSTED_HOSTS=

# Request limits, per client address, per minute. The general limit bounds
# resource use and must stay above the dashboard's own polling (it fetches four
# endpoints every five seconds, roughly 48/min). The auth limit is the
# security-relevant one: it bounds guesses at NEMOS_API_TOKEN, and nothing
# legitimate retries a rejected credential. /api/health is never limited.
NEMOS_API_RATE=240
NEMOS_API_AUTH_RATE=10

NEMOS_LOG_LEVEL=INFO

# --- Sensor watchdog ----------------------------------------------------------
# Detects a capture thread that dies without the process exiting -- confirmed
# on a real deployment, and something Restart=on-failure alone cannot catch.
# Always on; also pings systemd's own watchdog (WatchdogSec=) when healthy, so
# systemd restarts a hung process too. No effect outside systemd or without
# WatchdogSec set in the unit file.
#
# The silence check below is separate and OFF by default: a quiet network and
# a cable pull look identical from packet volume alone, so only enable this if
# your link should genuinely never go idle for this long.
# NEMOS_HEARTBEAT_SECONDS=300
NEMOS_WATCHDOG_POLL_SECONDS=15

# --- Windowed flow analysis and ML anomaly detection -------------------------
# NEMOS aggregates traffic into unidirectional flows, extracts features per
# source per window, and scores them with a locally trained Isolation Forest.
NEMOS_ANALYSIS=true

# Aggregation window in seconds. This MUST match the window the model was
# trained with: packet counts and rates scale with it, so a mismatch would make
# the scores meaningless. NEMOS refuses to load a mismatched model.
NEMOS_ANALYSIS_WINDOW=10.0

# Bound on the in-memory flow table, and whether flows are stored.
NEMOS_MAX_FLOWS=20000

# Events retained per source for the deterministic rules. Detection cost per
# packet is linear in this, so it is the dial for trading detection depth
# against capture-path throughput. Clamped to 200-100000; the floor keeps every
# rule reachable (the largest threshold is 150).
NEMOS_MAX_EVENTS=1000
NEMOS_PERSIST_FLOWS=true

# --- Detection rule tuning -----------------------------------------------------
# Every deterministic-rule threshold in nemos/detector.py is overridable, named
# NEMOS_DETECT_<FIELD> after the DetectionConfig field it sets (e.g. syn_flood
# -> NEMOS_DETECT_SYN_FLOOD). The defaults were tuned against real traffic and
# are the right starting point; the full list with clamps is in README.md. A
# few operators actually end up changing, left here as examples:
# NEMOS_DETECT_SYN_FLOOD=150
# NEMOS_DETECT_PORT_SCAN=8
# NEMOS_DETECT_SYN_FLOOD_CONCENTRATION=0.30
# NEMOS_DETECT_WINDOW=10

# Where the trained model lives. NEMOS trains one itself -- see below -- and
# you can still train one by hand:
#   python tools/train_model.py --source database --window 10
# Without a model NEMOS runs on deterministic rules plus the statistical
# baseline and says so; it does not fail.
NEMOS_MODEL_DIR=data/model

# --- Automatic model training ------------------------------------------------
# NEMOS bootstraps its own anomaly model. It keeps only the windows that every
# other detection layer judged unremarkable, and once it has enough of them
# over a long enough period it fits an Isolation Forest, validates it and
# activates it. Traffic NEMOS flagged never becomes training data.
#
# Set to false to keep training a manual, out-of-band operator action.
# NEMOS_ML_AUTOTRAIN=true
#
# Both conditions must hold before the first fit. The sample count alone is
# satisfied by one quiet minute repeated; the wall-clock period is what makes
# the corpus span real variation. Raise both on a busy network.
# NEMOS_ML_BOOTSTRAP_MIN_SECONDS=600
# NEMOS_ML_BOOTSTRAP_MIN_SAMPLES=1000
#
# How often the model is refitted from newly collected clean traffic. The
# active model keeps scoring throughout, and a replacement is promoted only
# after it validates. 0 disables retraining entirely.
# NEMOS_ML_RETRAIN_SECONDS=86400
#
# Bound on the stored training corpus. Oldest samples are dropped first, so
# what survives is the most recent picture of the network.
# NEMOS_ML_MAX_SAMPLES=20000

# --- Encrypted traffic (TLS fingerprinting) ----------------------------------
# NEMOS fingerprints the TLS handshake, which is sent in cleartext before a
# session key exists. It identifies the client software (JA3) and records the
# server name. Application data is never parsed and nothing is decrypted.
# No list of known-malicious fingerprints is shipped; see the README for why.
#
# NEMOS_DETECT_TLS_HORIZON=900
# NEMOS_DETECT_TLS_MAX_FINGERPRINTS=6
# NEMOS_DETECT_TLS_ODD_PORT_HANDSHAKES=3
# NEMOS_DETECT_TLS_MAX_TRACKED=16

# --- Optional LLM analyst ----------------------------------------------------
# Explains findings NEMOS already made. It performs NO detection, and nothing is
# sent anywhere unless a provider is set. Use "ollama" to keep it fully local.
# NEMOS_LLM_PROVIDER=ollama
# NEMOS_LLM_MODEL=llama3.1
# NEMOS_LLM_TIMEOUT=30
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Adaptive behavioral baseline
# Warm-up observations, sigma threshold, and sampling cadence.
NEMOS_BEHAVIOR_ALPHA=0.15
NEMOS_BEHAVIOR_MIN_SAMPLES=8
NEMOS_BEHAVIOR_SIGMA=3.0
NEMOS_BEHAVIOR_SAMPLE_SECONDS=5.0

# --- Outbound alert delivery -------------------------------------------------
# Delivery stays off until a channel below is configured. Findings are always
# recorded locally regardless; these settings only control the outbound copy.

# Optional Telegram alert channel (safe to leave empty).
#
# The token is a DEPLOYMENT-level secret: it identifies the bot itself, and one
# NEMOS install needs exactly one. Operators never see it. They link their own
# chat by scanning the QR code on the Sensor page, which is why the bot's
# username is needed too -- it is the public half that appears in the t.me link.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Legacy single-chat delivery. Still honoured, and still filled in for you by
# `python tools/connect_telegram.py`, but QR pairing replaces it: chats paired
# from the dashboard are added to the audience without editing this file.
TELEGRAM_CHAT_ID=

# Where an alert should link back to. Left empty, alerts carry no link -- NEMOS
# binds to loopback by default, and a URL only the sensor can reach helps
# nobody. Telegram will only render an inline button for an https:// URL.
# NEMOS_DASHBOARD_URL=https://nemos.internal.example

# Send a security summary once a day, at this hour (UTC, 0-23). Unset = off.
# NEMOS_TELEGRAM_BRIEF_HOUR=7

# Optional containment hook for a controlled lab. When set, a "Contain" button
# appears on Telegram alerts and pressing it runs this executable with the
# incident id as its only argument -- argv form, no shell, 20-second timeout,
# and every attempt is written to the audit log. NEMOS is a passive sensor and
# has no enforcement point of its own, so the action is entirely yours.
# NEMOS_TELEGRAM_CONTAIN_HOOK=/usr/local/bin/nemos-contain

# Optional webhook channel. Must be https:// unless it points at loopback.
NEMOS_WEBHOOK_URL=
NEMOS_WEBHOOK_TOKEN=

# Optional syslog/SIEM export: CEF over RFC 5424, which Splunk, QRadar, Elastic
# and Wazuh parse without a custom decoder. UDP by default so an unreachable
# collector cannot block delivery. Every field is escaped, so a newline inside
# a finding cannot forge a second record at the collector.
# NEMOS_SYSLOG_HOST=10.0.0.9
# NEMOS_SYSLOG_PORT=514
# NEMOS_SYSLOG_PROTOCOL=udp
# NEMOS_SYSLOG_FACILITY=13

# Master switch, and the severity floor for what gets sent.
NEMOS_NOTIFY=true
NEMOS_NOTIFY_MIN_SEVERITY=HIGH

# Flood control: seconds before the same finding from the same source repeats,
# and the global ceiling on messages per minute. These stop a port scan from
# turning the sensor into a message flood.
NEMOS_NOTIFY_COOLDOWN=300
NEMOS_NOTIFY_RATE=12
NEMOS_NOTIFY_TIMEOUT=5.0
NEMOS_NOTIFY_QUEUE=256
