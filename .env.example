# Safe local default: dashboard is only reachable from this machine.
NEMOS_HOST=127.0.0.1
NEMOS_PORT=5000

# Optional capture interface. Leave empty to let Scapy choose.
NEMOS_INTERFACE=

NEMOS_CAPTURE=true
NEMOS_DB=data/nemos.db
NEMOS_DB_BATCH=250
NEMOS_DB_FLUSH_SECONDS=0.5

# Required if NEMOS_HOST is not loopback.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
NEMOS_API_TOKEN=
# Required for wildcard remote binds such as 0.0.0.0. Comma-separated Host values.
NEMOS_TRUSTED_HOSTS=

NEMOS_LOG_LEVEL=INFO

# Adaptive behavioral baseline
# Warm-up observations, sigma threshold, and sampling cadence.
NEMOS_BEHAVIOR_ALPHA=0.15
NEMOS_BEHAVIOR_MIN_SAMPLES=8
NEMOS_BEHAVIOR_SIGMA=3.0
NEMOS_BEHAVIOR_SAMPLE_SECONDS=5.0

# --- Outbound alert delivery -------------------------------------------------
# Delivery stays off until a channel below is configured. Findings are always
# recorded locally regardless; these settings only control the outbound copy.

# Optional Telegram alert channel (safe to leave empty).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional webhook channel. Must be https:// unless it points at loopback.
NEMOS_WEBHOOK_URL=
NEMOS_WEBHOOK_TOKEN=

# Master switch, and the severity floor for what gets sent.
NEMOS_NOTIFY=true
NEMOS_NOTIFY_MIN_SEVERITY=HIGH

# Flood control: seconds before the same finding from the same source repeats,
# and the global ceiling on messages per minute. These stop a port scan from
# turning the sensor into a message flood.
NEMOS_NOTIFY_COOLDOWN=300
NEMOS_NOTIFY_RATE=12
NEMOS_NOTIFY_TIMEOUT=5.0
NEMOS_NOTIFY_QUEUE=256
